#!/usr/bin/env bash
# Mock for bats tests (section 11): records the call and exits with
# MOCK_EXIT (default 0), so steps never touch the real system in CI.
if [[ -n "${MOCK_CALLS_LOG:-}" ]]; then
	printf '%s %s\n' "$(basename "$0")" "$*" >>"$MOCK_CALLS_LOG"
fi
# MOCK_SURICATA_VERSION makes "suricata -V" answer like the real one.
if [[ "${1:-}" == "-V" && -n "${MOCK_SURICATA_VERSION:-}" ]]; then
	echo "This is Suricata version $MOCK_SURICATA_VERSION RELEASE"
fi
# "suricata --build-info" lists Redis support; MOCK_SURICATA_REDIS=no turns it off.
if [[ "${1:-}" == "--build-info" ]]; then
	echo "Redis support:                           ${MOCK_SURICATA_REDIS:-yes}"
fi
exit "${MOCK_EXIT:-0}"
