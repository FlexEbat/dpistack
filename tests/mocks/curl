#!/usr/bin/env bash
# Mock for bats tests (tech.md 11): records the call and exits with
# MOCK_EXIT (default 0), so steps never touch the real system in CI.
# MOCK_CURL_FAIL_MATCH: a call whose arguments contain this text exits 22
# (an HTTP error, as a missing repository would).
if [[ -n "${MOCK_CALLS_LOG:-}" ]]; then
	printf '%s %s\n' "$(basename "$0")" "$*" >>"$MOCK_CALLS_LOG"
fi
if [[ -n "${MOCK_CURL_FAIL_MATCH:-}" && "$*" == *"$MOCK_CURL_FAIL_MATCH"* ]]; then
	exit 22
fi
exit "${MOCK_EXIT:-0}"
