#!/usr/bin/env bash
# Mock ss(8) for bats tests: "ss -ltn" prints one LISTEN line per port
# in MOCK_SS_LISTEN (comma separated), using ss's real column layout
# (State Recv-Q Send-Q Local:Port Peer:Port).
if [[ -n "${MOCK_CALLS_LOG:-}" ]]; then
	printf '%s %s\n' "$(basename "$0")" "$*" >>"$MOCK_CALLS_LOG"
fi
echo "State  Recv-Q Send-Q Local Address:Port Peer Address:Port"
IFS=',' read -ra ports <<<"${MOCK_SS_LISTEN:-}"
for p in "${ports[@]}"; do
	[[ -z "$p" ]] && continue
	# With -p (ss -ltnp) the real ss adds the owner column; MOCK_SS_PROC names it.
	if [[ "$*" == *p* && -n "${MOCK_SS_PROC:-}" ]]; then
		echo "LISTEN 0      128    127.0.0.1:${p}   0.0.0.0:*  users:((\"${MOCK_SS_PROC}\",pid=4242,fd=3))"
	else
		echo "LISTEN 0      128    127.0.0.1:${p}   0.0.0.0:*"
	fi
done
exit "${MOCK_EXIT:-0}"
