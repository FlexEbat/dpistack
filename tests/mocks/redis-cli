#!/usr/bin/env bash
# Test double of redis-cli: logs its arguments; TYPE answers MOCK_REDIS_TYPE
# (none by default), XLEN answers MOCK_REDIS_XLEN (0 by default), DEL says 1.
echo "$*" >>"${MOCK_LOG:-/dev/null}"
args=("$@")
# drop -h <host> -p <port>
while [[ "${args[0]:-}" == -h || "${args[0]:-}" == -p ]]; do args=("${args[@]:2}"); done
case "${args[0],,}" in
type) echo "${MOCK_REDIS_TYPE:-none}" ;;
xlen) echo "${MOCK_REDIS_XLEN:-0}" ;;
del) echo 1 ;;
*) echo OK ;;
esac
