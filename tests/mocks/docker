#!/usr/bin/env bash
# Mock docker for bats tests: logs every call. Answers the compose queries
# dpistack makes:
#   MOCK_DOCKER_RUNNING   names printed by `ps --status running --services`
#   MOCK_DOCKER_PS        lines "service state" for `ps -a --format ...`
#   MOCK_DOCKER_IMAGE     printed by `ps --format {{.Image}}`
#   MOCK_DOCKER_COMPOSE_EXIT  exit of `docker compose version` (default 0)
#   MOCK_DOCKER_INFO_EXIT     exit of `docker info` (default 0; 1 = no usable daemon)
#   MOCK_DOCKER_RUN_FAIL      1 = the Go build container fails
#   MOCK_DOCKER_IMAGE_ABSENT  `docker image inspect` fails (the image is not built yet)
# Anything else exits with MOCK_EXIT (default 0).
if [[ -n "${MOCK_CALLS_LOG:-}" ]]; then
	printf '%s %s\n' "$(basename "$0")" "$*" >>"$MOCK_CALLS_LOG"
fi
case "$*" in
"info"*) exit "${MOCK_DOCKER_INFO_EXIT:-0}" ;;
"run --rm"*" -v "*":/out "*)
	# the Go build container: leave a stub binary in the /out mount
	for a in "$@"; do
		[[ "$a" == *":/out" ]] && out_dir="${a%:/out}"
	done
	if [[ -n "${out_dir:-}" && "${MOCK_DOCKER_RUN_FAIL:-0}" != "1" ]]; then
		printf '#!/bin/sh\nexit 0\n' >"$out_dir/dpistack-panel"
		chmod 0755 "$out_dir/dpistack-panel"
	fi
	exit "${MOCK_DOCKER_RUN_FAIL:-0}"
	;;
"image inspect"*) [[ -n "${MOCK_DOCKER_IMAGE_ABSENT:-}" ]] && exit 1 || exit 0 ;;
"compose version"*) exit "${MOCK_DOCKER_COMPOSE_EXIT:-0}" ;;
*" ps --status running --services"*)
	[[ -n "${MOCK_DOCKER_RUNNING:-}" ]] && printf '%s\n' "${MOCK_DOCKER_RUNNING}" | tr ' ' '\n'
	exit 0
	;;
*" ps -a --format "*)
	[[ -n "${MOCK_DOCKER_PS:-}" ]] && printf '%s\n' "${MOCK_DOCKER_PS}"
	exit 0
	;;
*" ps --format "*)
	[[ -n "${MOCK_DOCKER_IMAGE:-}" ]] && printf '%s\n' "${MOCK_DOCKER_IMAGE}"
	exit 0
	;;
esac
exit "${MOCK_EXIT:-0}"
