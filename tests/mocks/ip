#!/usr/bin/env bash
# Mock ip(8).
#  - "ip link show <iface>" succeeds only for MOCK_IP_EXISTING_IFACES.
#  - LAN detection answers, driven by env (empty = no answer, like a
#    host without a default route):
#      "ip -4 route show default"            -> MOCK_IP_DEFAULT_IFACE
#      "ip -4 -o addr show dev <if>"         -> MOCK_IP_ADDR (e.g. 192.168.10.5/24)
#      "ip -4 route show dev <if> scope link"-> MOCK_IP_LINK_ROUTE (e.g. 192.168.10.0/24)
if [[ -n "${MOCK_CALLS_LOG:-}" ]]; then
	printf '%s %s\n' "$(basename "$0")" "$*" >>"$MOCK_CALLS_LOG"
fi

if [[ "$1" == "link" && "$2" == "show" && -n "${3:-}" ]]; then
	iface="$3"
	IFS=',' read -ra existing <<<"${MOCK_IP_EXISTING_IFACES:-}"
	for e in "${existing[@]}"; do
		[[ "$e" == "$iface" ]] && exit 0
	done
	exit 1
fi

args=" $* "
if [[ "$args" == *" addr show scope global "* ]]; then
	# MOCK_IP_ADDRS: "iface=address/prefix" pairs separated by spaces
	n=2
	for pair in ${MOCK_IP_ADDRS:-}; do
		printf '%s: %s    inet %s brd 0.0.0.0 scope global dynamic %s\\       valid_lft 100sec preferred_lft 100sec\n' "$n" "${pair%%=*}" "${pair#*=}" "${pair%%=*}"
		n=$((n + 1))
	done
	exit 0
fi
if [[ "$args" == *" route show default "* ]]; then
	[[ -n "${MOCK_IP_DEFAULT_IFACE:-}" ]] && echo "default via 192.168.10.1 dev ${MOCK_IP_DEFAULT_IFACE} proto dhcp metric 100"
	exit 0
fi
if [[ "$args" == *" addr show dev "* ]]; then
	[[ -n "${MOCK_IP_ADDR:-}" ]] && echo "2: ${MOCK_IP_DEFAULT_IFACE:-eth0}    inet ${MOCK_IP_ADDR} brd 192.168.10.255 scope global eth0"
	exit 0
fi
if [[ "$args" == *" route show dev "* && "$args" == *" scope link "* ]]; then
	[[ -n "${MOCK_IP_LINK_ROUTE:-}" ]] && echo "${MOCK_IP_LINK_ROUTE} proto kernel scope link src 192.168.10.5"
	exit 0
fi

exit "${MOCK_EXIT:-0}"
