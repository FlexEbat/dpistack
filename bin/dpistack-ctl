#!/usr/bin/env bash
# Privileged helper invoked by the panel and watchdog via `sudo -n`
# (tech.md 4.5). Slice 1 only scaffolds the entry point so gate.sh has
# a real file to lint; each command in the 4.5 table ships with the
# slice that owns the component it controls.
set -uo pipefail

usage() {
	cat <<'EOF'
Использование: dpistack-ctl <команда> [аргументы]

Команды появляются по мере реализации соответствующих компонентов
(tech.md 4.5). Сейчас ни одна ещё не реализована.
EOF
}

main() {
	if [[ $# -eq 0 ]]; then
		usage
		exit 2
	fi
	echo "dpistack-ctl $1: пока не реализовано" >&2
	exit 4
}

main "$@"
