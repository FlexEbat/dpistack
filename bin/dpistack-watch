#!/usr/bin/env bash
# dpistack watchdog (section 8): one run per call, started by
# dpistack-watch.timer or by `dpistack health`. It writes
# health.json atomically and a line to events.jsonl for every status
# change. It repairs nothing unless WATCH_AUTORESTART=yes.
#
# Ready-made parts instead of new code: jq builds and reads the JSON,
# flock keeps two runs apart, `dpistack status --json` gives the
# component state through the runtime, and the schema supplies every
# default threshold.
set -uo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
for _lib in "$SCRIPT_DIR/../lib" "$SCRIPT_DIR/../lib/dpistack/installer/lib"; do
	if [[ -r "$_lib/paths.sh" && -r "$_lib/common.sh" ]]; then
		# shellcheck source=lib/paths.sh
		source "$_lib/paths.sh"
		# shellcheck source=lib/common.sh
		source "$_lib/common.sh"
		# shellcheck source=lib/state.sh
		source "$_lib/state.sh"
		# shellcheck source=lib/schema.sh
		source "$_lib/schema.sh"
		# shellcheck source=lib/config.sh
		source "$_lib/config.sh"
		# shellcheck source=lib/migrate.sh
		source "$_lib/migrate.sh"
		break
	fi
done
unset _lib
if ! declare -F path_conf >/dev/null; then
	echo "dpistack-watch: lib/paths.sh not found" >&2
	exit 1
fi
command -v jq >/dev/null 2>&1 || {
	echo "dpistack-watch: jq is not installed" >&2
	exit 1
}

# awk prints decimals by the locale; "5,00" would break the JSON values.
export LC_NUMERIC=C

CTL="${DPISTACK_BIN:-$SCRIPT_DIR/dpistack}"
[[ -x "$CTL" ]] || CTL="$SCRIPT_DIR/../install.sh"
RESTARTS_PER_HOUR=3
PORT_CRIT_AFTER_MISSES=3 # missing for more than two runs in a row

# DPISTACK_NOW pins the clock for tests.
now() { echo "${DPISTACK_NOW:-$(date +%s)}"; }
iso() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; }

CHECK_IDS=()
declare -A C_STATUS C_VALUE C_DETAIL

# record <id> <status> <value> <detail>
record() {
	CHECK_IDS+=("$1")
	C_STATUS[$1]="$2"
	C_VALUE[$1]="$3"
	C_DETAIL[$1]="$4"
}

# ge/le <number> <threshold>: at the threshold itself the worse status
# wins, the same way for every check (4.6 note).
ge() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a >= b)}'; }
le() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a <= b)}'; }

eve_checks_apply() {
	[[ "${CONF[EVE_FILE]}" == "yes" && ",${CONF[EVE_TYPES]}," == *",stats,"* ]]
}

declare -A COMP_STATE

# STATUS_READ is "yes" when `dpistack status --json` gave a component list.
# Without it no component is checked at all, so the run must not look healthy:
# check_status_read turns the failure into a check of its own.
STATUS_READ=no

load_component_states() {
	local out
	out=$("$CTL" status --json 2>/dev/null) || return 0
	jq -e '.components | type == "array"' >/dev/null 2>&1 <<<"$out" || return 0
	STATUS_READ=yes
	while IFS=$'\t' read -r id state; do
		COMP_STATE[$id]="$state"
	done < <(jq -r '.components[] | [.id, .state] | @tsv' <<<"$out" 2>/dev/null)
}

check_status_read() {
	if [[ "$STATUS_READ" == "yes" ]]; then
		record watch.status ok "" ""
	else
		record watch.status warn "" "the component states could not be read (dpistack status --json failed or printed no list), so no component was checked in this run; run: dpistack status"
	fi
}

check_process() {
	local id="$1" state="${COMP_STATE[$1]:-absent}"
	case "$state" in
	active) record "$id.process" ok "$state" "" ;;
	absent) record "$id.process" na "$state" "component not installed" ;;
	*) record "$id.process" crit "$state" "$id: $state" ;;
	esac
}

# backend_port <public-port> - with ACCESS_MODE=nginx the services listen
# on <public>+10000 behind nginx (section 7, same rule as access_backend_port
# in the installer); the check must look at the service, not at nginx.
backend_port() {
	if [[ "${CONF[ACCESS_MODE]:-localhost}" == "nginx" ]]; then
		echo $(($1 + 10000))
	else
		echo "$1"
	fi
}

# component_port <id> - empty when the component has no port to check.
component_port() {
	case "$1" in
	evebox) backend_port "${CONF[EVEBOX_PORT]}" ;;
	ntopng) backend_port "${CONF[NTOPNG_PORT]}" ;;
	redis) echo 6379 ;;
	panel) backend_port "${CONF[PANEL_PORT]}" ;;
	victoriametrics | prometheus) echo "${CONF[METRICS_BACKEND_PORT]}" ;;
	node_exporter) echo "${CONF[NODE_EXPORTER_PORT]}" ;;
	grafana) echo "${CONF[GRAFANA_PORT]}" ;;
	esac
}

check_port() {
	local id="$1" port misses key
	port=$(component_port "$id")
	if [[ "${COMP_STATE[$id]:-absent}" == "absent" || -z "$port" ]]; then
		record "$id.port" na "" "component not installed"
		return
	fi
	key="watch.miss.$id"
	if ss -ltn 2>/dev/null | awk -v p=":$port\$" '$4 ~ p {f=1} END{exit !f}'; then
		state_write_value "$key" 0
		record "$id.port" ok "$port" ""
		return
	fi
	misses=$(state_read_value "$key")
	misses=$((${misses:-0} + 1))
	state_write_value "$key" "$misses"
	if ((misses >= PORT_CRIT_AFTER_MISSES)); then
		record "$id.port" crit "$port" "port $port is not listening for $misses runs in a row"
	else
		record "$id.port" warn "$port" "port $port is not listening"
	fi
}

check_eve_fresh() {
	if ! eve_checks_apply; then
		record suricata.eve_fresh na "" "EVE_FILE=no or no stats in EVE_TYPES"
		return
	fi
	local eve mtime age
	eve=$(path_suricata_eve_json)
	if [[ ! -f "$eve" ]]; then
		record suricata.eve_fresh warn "" "eve.json not found"
		return
	fi
	mtime=$(stat -c %Y "$eve")
	age=$(($(now) - mtime))
	if ge "$age" "${CONF[WATCH_EVE_STALE_SEC]}"; then
		record suricata.eve_fresh crit "$age" "no new events for $age s"
	else
		record suricata.eve_fresh ok "$age" ""
	fi
}

check_drop_rate() {
	if ! eve_checks_apply; then
		record suricata.drop_rate na "" "EVE_FILE=no or no stats in EVE_TYPES"
		return
	fi
	local eve
	eve=$(path_suricata_eve_json)
	if [[ ! -f "$eve" ]]; then
		record suricata.drop_rate na "" "eve.json not found"
		return
	fi
	# Only the tail is read, never the whole file (9: eve.json is not parsed whole).
	local rows p0 d0 p1 d1
	rows=$(tail -c 4194304 "$eve" | grep -F '"event_type":"stats"' | tail -n 2 |
		jq -r '[.stats.capture.kernel_packets, .stats.capture.kernel_drops] | select(all(. != null)) | @tsv' 2>/dev/null)
	if [[ $(wc -l <<<"$rows") -lt 2 ]]; then
		record suricata.drop_rate na "" "fewer than two stats events"
		return
	fi
	read -r p0 d0 < <(sed -n 1p <<<"$rows")
	read -r p1 d1 < <(sed -n 2p <<<"$rows")
	if ((p1 < p0 || d1 < d0)); then
		record suricata.drop_rate ok "" "counters were reset, the interval is skipped"
		return
	fi
	# Thresholds are compared as integers (drops*100 against pct*packets),
	# so a value just under a threshold is never rounded up onto it.
	local dp=$((p1 - p0)) dd=$((d1 - d0)) pct=0.00
	local crit_pct="${CONF[WATCH_DROP_CRIT_PCT]}" warn_pct="${CONF[WATCH_DROP_WARN_PCT]}"
	((dp > 0)) && pct=$(awk -v dp="$dp" -v dd="$dd" 'BEGIN{printf "%.2f", dd * 100 / dp}')
	if ((dp > 0)) && ge "$((dd * 100))" "$((crit_pct * dp))"; then
		record suricata.drop_rate crit "$pct" "drops $pct%; to reduce them raise CAPTURE_THREADS, CAPTURE_RING_SIZE or the memcaps, and set NIC_OFFLOADS_OFF=yes"
	elif ((dp > 0)) && ge "$((dd * 100))" "$((warn_pct * dp))"; then
		record suricata.drop_rate warn "$pct" "drops $pct%; to reduce them raise CAPTURE_THREADS, CAPTURE_RING_SIZE or the memcaps, and set NIC_OFFLOADS_OFF=yes"
	else
		record suricata.drop_rate ok "$pct" ""
	fi
}

check_disk_free() {
	local -a paths=()
	paths+=("$(dirname "$(path_suricata_eve_json)")")
	[[ "${CONF[EVEBOX_DB]}" == "sqlite" ]] && paths+=("$(path_evebox_data_dir)")
	# The series of the metrics backend are the fastest-growing data.
	[[ "${CONF[METRICS_BACKEND]:-none}" != "none" && -d "$(path_metrics_data_dir)" ]] && paths+=("$(path_metrics_data_dir)")
	local p total avail worst_total="" worst_avail="" worst_path=""
	for p in "${paths[@]}"; do
		[[ -d "$p" ]] || continue
		read -r total avail < <(df -P "$p" 2>/dev/null | awk 'NR==2 && $2 > 0 {print $2, $4}')
		[[ -n "${total:-}" ]] || continue
		# The smallest free share wins: avail/total, cross-multiplied.
		if [[ -z "$worst_total" ]] || awk -v a="$avail" -v t="$total" -v wa="$worst_avail" -v wt="$worst_total" 'BEGIN{exit !(a * wt <= wa * t)}'; then
			worst_total="$total"
			worst_avail="$avail"
			worst_path="$p"
		fi
	done
	if [[ -z "$worst_total" ]]; then
		record disk.free na "" "no directories to check"
		return
	fi
	local pct detail
	pct=$(awk -v a="$worst_avail" -v t="$worst_total" 'BEGIN{printf "%.2f", a * 100 / t}')
	detail="$worst_path: $pct% free"
	if awk -v a="$worst_avail" -v t="$worst_total" -v c="${CONF[WATCH_DISK_CRIT_PCT]}" 'BEGIN{exit !(a * 100 <= c * t)}'; then
		record disk.free crit "$pct" "$detail"
	elif awk -v a="$worst_avail" -v t="$worst_total" -v c="${CONF[WATCH_DISK_WARN_PCT]}" 'BEGIN{exit !(a * 100 <= c * t)}'; then
		record disk.free warn "$pct" "$detail"
	else
		record disk.free ok "$pct" "$detail"
	fi
}

# check_redis_stream - the stream of the Redis output (EVE_REDIS) stays near
# EVE_REDIS_MAXLEN: Redis trims it, so twice that length means the trim does
# not work and the memory of the Redis that ntopng uses is at risk.
check_redis_stream() {
	local target host port key maxlen len
	if ! command -v redis-cli >/dev/null 2>&1 || ! target=$(suricata_redis_target 2>/dev/null); then
		record redis.eve_stream na "" "EVE_REDIS is off or redis-cli is not installed"
		return
	fi
	read -r host port key <<<"$target"
	# Without hiredis the installer leaves the Redis output out of suricata.yaml:
	# the stream stays empty, which would otherwise read as a healthy 0.
	if ! suricata_has_redis; then
		record redis.eve_stream warn "" "EVE_REDIS is set but this Suricata was built without hiredis, so nothing is written to the stream (use SURICATA_SOURCE=source or a Suricata built with Redis support)"
		return
	fi
	maxlen="${CONF[EVE_REDIS_MAXLEN]:-100000}"
	if ! len=$(redis-cli -h "$host" -p "$port" xlen "$key" 2>/dev/null) || [[ ! "$len" =~ ^[0-9]+$ ]]; then
		record redis.eve_stream warn "" "the stream $key on $host:$port cannot be read"
	elif ge "$len" "$((maxlen * 2))"; then
		record redis.eve_stream warn "$len" "the stream holds $len events, the bound is $maxlen"
	else
		record redis.eve_stream ok "$len" ""
	fi
}

# check_migrate_pending - an upgrade left work on this host (lib/migrate.sh):
# a migration of a newer version or a source build of an older recipe. The
# Overview of the panel shows the detail line, and `dpistack migrate` does it.
check_migrate_pending() {
	if [[ -z "$(migrate_from_version)" ]]; then
		record migrate.pending na "" "no finished install"
	elif migrate_needed; then
		record migrate.pending warn "" "this host still has work from an earlier version: run sudo dpistack migrate (details: dpistack migrate --plan)"
	else
		record migrate.pending ok "" ""
	fi
}

check_rules_age() {
	if [[ "${CONF[RULES_UPDATE]}" == "off" || "${COMP_STATE[suricata]:-absent}" == "absent" ]]; then
		record rules.age na "" "rule updates are off or Suricata is not installed"
		return
	fi
	local rules mtime age_sec age_days crit_days="${CONF[WATCH_RULES_CRIT_DAYS]}" warn_days="${CONF[WATCH_RULES_WARN_DAYS]}"
	rules=$(path_suricata_ruleset)
	if [[ ! -f "$rules" ]]; then
		record rules.age warn "" "suricata.rules not found"
		return
	fi
	mtime=$(stat -c %Y "$rules")
	age_sec=$(($(now) - mtime))
	age_days=$(awk -v s="$age_sec" 'BEGIN{printf "%.2f", s / 86400}')
	if ge "$age_sec" "$((crit_days * 86400))"; then
		record rules.age crit "$age_days" "rules are $age_days days old"
	elif ge "$age_sec" "$((warn_days * 86400))"; then
		record rules.age warn "$age_days" "rules are $age_days days old"
	else
		record rules.age ok "$age_days" ""
	fi
}

rank() {
	case "$1" in
	ok) echo 0 ;;
	warn) echo 1 ;;
	crit) echo 2 ;;
	*) echo -1 ;;
	esac
}

# ---------------------------------------------------------------- alerts
# Channels are independent: a failing one writes its reason to stderr
# (the journal of the oneshot unit) and never stops the others or the
# events.jsonl line. Tokens and passwords travel to curl through
# `-K -` on stdin, so they are not visible in `ps` and never printed.

CHANNELS=()

channel_on() {
	local c
	for c in "${CHANNELS[@]}"; do
		[[ "$c" == "$1" ]] && return 0
	done
	return 1
}

channel_error() {
	echo "dpistack-watch: channel $1: $2" >&2
}

# curl_cfg_escape <text> - a value inside quotes of a curl config line.
curl_cfg_escape() {
	local t="$1"
	t="${t//\\/\\\\}"
	t="${t//\"/\\\"}"
	t="${t//$'\n'/ }"
	t="${t//$'\r'/ }"
	printf '%s' "$t"
}

alert_log() {
	local sev="$1" msg="$2"
	logger -t dpistack-watch -p "daemon.$sev" -- "$msg" || channel_error log "logger failed"
}

alert_tg() {
	local msg="$1" token="${SECRETS[ALERT_TG_TOKEN]:-}" chat="${CONF[ALERT_TG_CHAT_ID]:-}"
	if [[ -z "$token" || -z "$chat" ]]; then
		channel_error tg "ALERT_TG_TOKEN or ALERT_TG_CHAT_ID is not set"
		return 1
	fi
	printf 'url = "https://api.telegram.org/bot%s/sendMessage"\ndata-urlencode = "chat_id=%s"\ndata-urlencode = "text=%s"\n' \
		"$(curl_cfg_escape "$token")" "$(curl_cfg_escape "$chat")" "$(curl_cfg_escape "$msg")" |
		curl -sS --fail --max-time 10 -o /dev/null -K - 2>/dev/null || {
		channel_error tg "sending failed"
		return 1
	}
}

alert_mail() {
	local subject="$1" msg="$2" url="${SECRETS[ALERT_SMTP_URL]:-}"
	local to="${CONF[ALERT_MAIL_TO]:-}" from="${CONF[ALERT_MAIL_FROM]:-}"
	if [[ -z "$url" || -z "$to" || -z "$from" ]]; then
		channel_error mail "ALERT_SMTP_URL, ALERT_MAIL_TO or ALERT_MAIL_FROM is not set"
		return 1
	fi
	local body cfg rcpt rc
	body=$(mktemp)
	chmod 0600 "$body"
	printf 'From: %s\nTo: %s\nSubject: %s\nMIME-Version: 1.0\nContent-Type: text/plain; charset=utf-8\n\n%s\n' \
		"$from" "$to" "$subject" "$msg" >"$body"
	cfg=$(printf 'url = "%s"\nmail-from = "%s"\nupload-file = "%s"\n' \
		"$(curl_cfg_escape "$url")" "$(curl_cfg_escape "$from")" "$body")
	local -a rcpts=()
	# read -a, not an unquoted expansion: no globbing of the address list.
	IFS=, read -ra rcpts <<<"$to"
	for rcpt in "${rcpts[@]}"; do
		cfg+=$'\n'"mail-rcpt = \"$(curl_cfg_escape "$rcpt")\""
	done
	printf '%s\n' "$cfg" | curl -sS --fail --max-time 20 -o /dev/null -K - 2>/dev/null
	rc=$?
	rm -f "$body"
	((rc == 0)) || {
		channel_error mail "sending failed"
		return 1
	}
}

# alert_webhook <severity> <subject> <message> - one POST to ALERT_WEBHOOK_URL.
# The body follows ALERT_WEBHOOK_FORMAT: json (our own shape), slack and
# discord (a hook URL is the credential, which is why it is a secret), ntfy
# (a plain text body, the subject and the priority in headers).
alert_webhook() {
	local sev="$1" subject="$2" msg="$3" url="${SECRETS[ALERT_WEBHOOK_URL]:-}"
	local fmt="${CONF[ALERT_WEBHOOK_FORMAT]:-json}" body ctype="application/json" extra="" prio=3
	if [[ -z "$url" ]]; then
		channel_error webhook "ALERT_WEBHOOK_URL is not set"
		return 1
	fi
	case "$fmt" in
	slack) body=$(jq -nc --arg t "$msg" '{text: $t}') ;;
	discord) body=$(jq -nc --arg t "$msg" '{content: $t[0:2000]}') ;;
	ntfy)
		body="$msg"
		ctype="text/plain; charset=utf-8"
		case "$sev" in
		err) prio=5 ;;
		warning) prio=4 ;;
		esac
		extra=$(printf 'header = "Title: %s"\nheader = "Priority: %s"\n' "$(curl_cfg_escape "$subject")" "$prio")
		;;
	*)
		body=$(jq -nc --arg ts "$(iso "$(now)")" --arg host "$(hostname -s 2>/dev/null || echo host)" \
			--arg sev "$sev" --arg subject "$subject" --arg message "$msg" \
			'{ts: $ts, host: $host, severity: $sev, subject: $subject, message: $message}')
		;;
	esac
	{
		printf 'url = "%s"\nheader = "Content-Type: %s"\n' "$(curl_cfg_escape "$url")" "$ctype"
		[[ -n "$extra" ]] && printf '%s\n' "$extra"
		printf 'data-binary = "%s"\n' "$(curl_cfg_escape "$body")"
	} | curl -sS --fail --max-time 10 -o /dev/null -K - 2>/dev/null || {
		channel_error webhook "sending failed"
		return 1
	}
}

# alert_syslog <severity> <message> - one message to a remote syslog server.
# The target is host[:port] or [v6address][:port]; the port is 514 by default.
alert_syslog() {
	local sev="$1" msg="$2" target="${CONF[ALERT_SYSLOG_TARGET]:-}" host port=514
	local -a proto=(--udp)
	if [[ -z "$target" ]]; then
		channel_error syslog "ALERT_SYSLOG_TARGET is not set"
		return 1
	fi
	if [[ "$target" =~ ^\[([0-9A-Fa-f:.]+)\](:([0-9]+))?$ ]]; then
		host="${BASH_REMATCH[1]}"
		port="${BASH_REMATCH[3]:-514}"
	else
		host="${target%%:*}"
		[[ "$target" == *:* ]] && port="${target##*:}"
	fi
	[[ "${CONF[ALERT_SYSLOG_PROTO]:-udp}" == "tcp" ]] && proto=(--tcp)
	logger -t dpistack-watch -p "daemon.$sev" -n "$host" -P "$port" "${proto[@]}" -- "$msg" || {
		channel_error syslog "sending failed"
		return 1
	}
}

# deliver <channel> <severity> <subject> <message> - one message to one
# delivery channel. The panel is not here: it has its own record (events.jsonl
# for a health change). A failing channel reports itself and is not an error of
# the run.
deliver() {
	case "$1" in
	log) alert_log "$2" "$4" ;;
	tg) alert_tg "$4" ;;
	mail) alert_mail "$3" "$4" ;;
	webhook) alert_webhook "$2" "$3" "$4" ;;
	syslog) alert_syslog "$2" "$4" ;;
	esac
	return 0
}

# notify <id> <from> <to> <detail> <kind> <since>
# kind: change | repeat | recovery. One message per channel.
notify() {
	local id="$1" from="$2" to="$3" detail="$4" kind="$5" since="$6" msg sev=warning host
	host=$(hostname -s 2>/dev/null || echo host)
	case "$kind" in
	recovery)
		msg="[dpistack] $host: $id recovered ($from -> $to)"
		sev=notice
		;;
	repeat)
		msg="[dpistack] $host: $id is still $to: $detail (since $since)"
		;;
	*) msg="[dpistack] $host: $id $from -> $to: $detail" ;;
	esac
	[[ "$to" == "crit" ]] && sev=err

	if channel_on panel; then
		jq -nc --arg ts "$(iso "$(now)")" --arg check "$id" --arg from "$from" --arg to "$to" \
			--arg detail "$detail" --arg kind "$kind" \
			'{ts: $ts, check: $check, from: $from, to: $to, detail: $detail, kind: $kind}' >>"$(path_events_jsonl)"
		chmod 0644 "$(path_events_jsonl)"
	fi
	local c
	for c in log tg mail webhook syslog; do
		channel_on "$c" && { deliver "$c" "$sev" "dpistack: $id $to" "$msg" || true; }
	done
	return 0
}

# alert_for <id> <prev-status> <prev-since> <status> <since> <detail>
# decides whether this run sends something and records the time.
alert_for() {
	local id="$1" prev="$2" status="$4" since="$5" detail="$6" key last now_s
	key="watch.alerted.$id"
	now_s=$(now)
	if [[ "$prev" != "$status" ]]; then
		case "$status" in
		warn | crit)
			notify "$id" "${prev:-na}" "$status" "$detail" change "$since"
			state_write_value "$key" "$now_s"
			;;
		ok)
			if [[ "$prev" == "warn" || "$prev" == "crit" ]]; then
				notify "$id" "$prev" "$status" "$detail" recovery "$since"
				state_write_value "$key" 0
			fi
			;;
		esac
		return 0
	fi
	[[ "$status" == "warn" || "$status" == "crit" ]] || return 0
	local repeat_min="${CONF[WATCH_REPEAT_MIN]}" repeat_sec
	repeat_sec=$((repeat_min * 60))
	((repeat_sec > 0)) || return 0
	last=$(state_read_value "$key")
	if [[ -z "$last" ]] || ((now_s - last >= repeat_sec)); then
		notify "$id" "$status" "$status" "$detail" repeat "$since"
		state_write_value "$key" "$now_s"
	fi
}

# ------------------------------------------------------- detection alerts
# A Suricata alert is not a health check: nothing in the checks above would
# report it. detect_notify reads what eve.json gained since the last run
# (the position is kept in detect-notify.json: inode, offset, the hour window
# and the alerts already sent), picks the alerts of the chosen severity and
# sends each to the delivery channels, once per signature, source and
# destination in the de-duplication window and at most
# DETECT_NOTIFY_MAX_PER_HOUR in an hour. What the limit held back is counted
# and announced in one message when the hour turns.

DETECT_READ_CAP=4194304 # bytes of eve.json read in one run
DETECT_MAX_PER_RUN=25   # a failing channel costs up to 10 s per message

declare -A DETECT_SEEN DETECT_HELD_SIG

# detect_severity_rank <name> - Suricata severity: 1 high, 2 medium, 3 low.
detect_severity_rank() {
	case "$1" in
	high) echo 1 ;;
	medium) echo 2 ;;
	*) echo 3 ;;
	esac
}

# detect_channels - the channels for detections, one per line, never panel.
detect_channels() {
	local list="${CONF[DETECT_NOTIFY_CHANNELS]:-}" c
	[[ -n "$list" ]] || list="${CONF[ALERT_CHANNELS]}"
	local -a all=()
	IFS=',' read -ra all <<<"$list"
	for c in "${all[@]}"; do
		[[ -n "$c" && "$c" != "panel" ]] && echo "$c"
	done
	return 0
}

# detect_send <severity-rank> <subject> <message> - to every detection channel.
detect_send() {
	local rank="$1" subject="$2" msg="$3" sev=notice c
	case "$rank" in
	1) sev=err ;;
	2) sev=warning ;;
	esac
	for c in "${DETECT_CHANNELS[@]}"; do
		deliver "$c" "$sev" "$subject" "$msg" || true
	done
}

# detect_save <inode> <offset> <hour-start> <sent> <held> - the state file.
detect_save() {
	local seen_json sig_json k
	seen_json=$(for k in "${!DETECT_SEEN[@]}"; do printf '%s\t%s\n' "$k" "${DETECT_SEEN[$k]}"; done |
		jq -Rn '[inputs | split("\t") | {key: .[0], value: (.[1] | tonumber)}] | from_entries')
	sig_json=$(for k in "${!DETECT_HELD_SIG[@]}"; do printf '%s\t%s\n' "$k" "${DETECT_HELD_SIG[$k]}"; done |
		jq -Rn '[inputs | split("\t") | {key: .[0], value: (.[1] | tonumber)}] | from_entries')
	jq -n --argjson inode "$1" --argjson offset "$2" --argjson hour "$3" --argjson sent "$4" --argjson held "$5" \
		--argjson seen "$seen_json" --argjson sigs "$sig_json" \
		'{inode: $inode, offset: $offset, hour: $hour, sent: $sent, held: $held, held_sigs: $sigs, seen: $seen}' |
		atomic_write "$(path_detect_notify_json)"
	chmod 0600 "$(path_detect_notify_json)"
}

detect_notify() {
	[[ "${CONF[DETECT_NOTIFY]:-no}" == "yes" && "${CONF[EVE_FILE]:-yes}" == "yes" && "${CONF[SURICATA_ENABLE]:-yes}" == "yes" ]] || return 0
	local eve state_file now_s inode size
	eve=$(path_suricata_eve_json)
	[[ -r "$eve" ]] || return 0
	mapfile -t DETECT_CHANNELS < <(detect_channels)
	((${#DETECT_CHANNELS[@]} > 0)) || return 0
	state_file=$(path_detect_notify_json)
	now_s=$(now)
	inode=$(stat -c %i "$eve")
	size=$(stat -c %s "$eve")

	local st="{}" old_inode offset hour sent held
	[[ -r "$state_file" ]] && st=$(jq -c . "$state_file" 2>/dev/null || echo "{}")
	old_inode=$(jq -r '.inode // empty' <<<"$st")
	offset=$(jq -r '.offset // empty' <<<"$st")
	hour=$(jq -r '.hour // 0' <<<"$st")
	sent=$(jq -r '.sent // 0' <<<"$st")
	held=$(jq -r '.held // 0' <<<"$st")
	DETECT_SEEN=()
	DETECT_HELD_SIG=()
	local k v window=$((${CONF[DETECT_NOTIFY_DEDUP_MIN]:-60} * 60))
	while IFS=$'\t' read -r k v; do
		[[ -n "$k" ]] && ((now_s - v < window)) && DETECT_SEEN[$k]="$v"
	done < <(jq -r '.seen // {} | to_entries[] | [.key, .value] | @tsv' <<<"$st" 2>/dev/null)
	while IFS=$'\t' read -r k v; do
		[[ -n "$k" ]] && DETECT_HELD_SIG[$k]="$v"
	done < <(jq -r '.held_sigs // {} | to_entries[] | [.key, .value] | @tsv' <<<"$st" 2>/dev/null)

	# The first run starts at the end of the file: the history that was there
	# before the setting was turned on is not sent (D185).
	if [[ -z "$offset" ]]; then
		detect_save "$inode" "$size" "$now_s" 0 0
		return 0
	fi
	# A new file (rotation) or a shorter one (truncation) is read from its start.
	if [[ "$old_inode" != "$inode" ]] || ((size < offset)); then
		offset=0
	fi

	# The hour turned: say what the limit held back.
	if ((now_s - hour >= 3600)); then
		if ((held > 0)); then
			local top
			top=$(for k in "${!DETECT_HELD_SIG[@]}"; do printf '%s\t%s\n' "${DETECT_HELD_SIG[$k]}" "$k"; done |
				sort -rn | head -n 3 | awk -F'\t' '{printf "%s%s (%s)", sep, $2, $1; sep = "; "}')
			detect_send 2 "dpistack: $held detections held back" \
				"[dpistack] $(hostname -s 2>/dev/null || echo host): $held more detections in the last hour were not sent (limit ${CONF[DETECT_NOTIFY_MAX_PER_HOUR]:-20} per hour). Most frequent: ${top:-n/a}"
		fi
		hour="$now_s"
		sent=0
		held=0
		DETECT_HELD_SIG=()
	fi

	local tmp consumed=0 bytes partial
	tmp=$(mktemp)
	if ((size > offset)); then
		tail -c "+$((offset + 1))" "$eve" 2>/dev/null | head -c "$DETECT_READ_CAP" >"$tmp"
		bytes=$(wc -c <"$tmp")
		partial=$(tail -n 1 "$tmp" | wc -c)
		# A last line without its newline is still being written: leave it.
		if [[ "$(tail -c 1 "$tmp" | od -An -c | tr -d ' ')" == '\n' ]]; then
			consumed="$bytes"
		else
			consumed=$((bytes - partial))
		fi
		# A single line longer than the cap would block the reader for good.
		((consumed == 0 && bytes >= DETECT_READ_CAP)) && consumed="$bytes"
	fi

	local max_rank max_hour="${CONF[DETECT_NOTIFY_MAX_PER_HOUR]:-20}" this_run=0
	max_rank=$(detect_severity_rank "${CONF[DETECT_NOTIFY_SEVERITY]:-high}")
	local host rank sid sig cat src sport dst dport proto app action key label
	host=$(hostname -s 2>/dev/null || echo host)
	if ((consumed > 0)); then
		while IFS=$'\t' read -r rank sid sig cat src sport dst dport proto app action; do
			[[ -n "$rank" ]] || continue
			key="$sid|$src|$dst"
			if ((window > 0)) && [[ -n "${DETECT_SEEN[$key]:-}" ]]; then
				continue
			fi
			if ((sent >= max_hour || this_run >= DETECT_MAX_PER_RUN)); then
				held=$((held + 1))
				DETECT_HELD_SIG[$sig]=$((${DETECT_HELD_SIG[$sig]:-0} + 1))
				continue
			fi
			case "$rank" in
			1) label=HIGH ;;
			2) label=MEDIUM ;;
			*) label=LOW ;;
			esac
			local flow="$src:$sport -> $dst:$dport $proto"
			[[ -n "$app" && "$app" != "failed" ]] && flow+="/$app"
			local what="$sig (sid $sid"
			[[ -n "$cat" ]] && what+=", $cat"
			what+=")"
			[[ "$action" == "blocked" ]] && what+=" blocked"
			detect_send "$rank" "dpistack: $label $sig" "[dpistack] $host: $label detection: $what $flow"
			DETECT_SEEN[$key]="$now_s"
			sent=$((sent + 1))
			this_run=$((this_run + 1))
		done < <(head -c "$consumed" "$tmp" | jq -rR --argjson max "$max_rank" '
			fromjson? | select(.event_type == "alert" and ((.alert.severity // 3) <= $max))
			| [(.alert.severity // 3), (.alert.signature_id // 0), ((.alert.signature // "") | .[0:200]),
			   (.alert.category // ""), (.src_ip // ""), (.src_port // 0), (.dest_ip // ""), (.dest_port // 0),
			   (.proto // ""), (.app_proto // ""), (.alert.action // "allowed")] | @tsv' 2>/dev/null)
	fi
	rm -f "$tmp"
	detect_save "$inode" "$((offset + consumed))" "$hour" "$sent" "$held"
}

# write_health - `since` stays while a status is unchanged. Alerts go
# out on a change and, while the status is not ok, every WATCH_REPEAT_MIN.
write_health() {
	local health prev_status prev_since since overall="ok" worst=0 r ts
	ts=$(iso "$(now)")
	health=$(path_health_json)
	mkdir -p "$(dirname "$health")"

	local lines="" id line
	for id in "${CHECK_IDS[@]}"; do
		prev_status="" prev_since=""
		if [[ -f "$health" ]]; then
			IFS=$'\t' read -r prev_status prev_since < <(
				jq -r --arg id "$id" '.checks[]? | select(.id == $id) | [.status, .since] | @tsv' "$health" 2>/dev/null
			)
		fi
		if [[ "$prev_status" == "${C_STATUS[$id]}" && -n "$prev_since" ]]; then
			since="$prev_since"
		else
			since="$ts"
		fi
		alert_for "$id" "$prev_status" "$prev_since" "${C_STATUS[$id]}" "$since" "${C_DETAIL[$id]}"
		r=$(rank "${C_STATUS[$id]}")
		((r > worst)) && worst=$r
		line=$(jq -nc --arg id "$id" --arg status "${C_STATUS[$id]}" --arg value "${C_VALUE[$id]}" \
			--arg detail "${C_DETAIL[$id]}" --arg since "$since" \
			'{id: $id, status: $status, value: $value, detail: $detail, since: $since}')
		lines+="$line"$'\n'
	done
	case "$worst" in
	1) overall=warn ;;
	2) overall=crit ;;
	esac
	printf '%s' "$lines" | jq -s --arg ts "$ts" --arg overall "$overall" \
		'{ts: $ts, overall: $overall, checks: .}' | atomic_write "$health"
	chmod 0644 "$health"
}

# autorestart: at most 3 restarts per component per hour.
autorestart() {
	[[ "${CONF[WATCH_AUTORESTART]}" == "yes" ]] || return 0
	local id key stamps t now_s kept
	now_s=$(now)
	for id in "${CHECK_IDS[@]}"; do
		[[ "$id" == *.process && "${C_STATUS[$id]}" == "crit" ]] || continue
		id="${id%.process}"
		key="watch.restarts.$id"
		kept=()
		for t in $(state_read_value "$key"); do
			((now_s - t < 3600)) && kept+=("$t")
		done
		if ((${#kept[@]} >= RESTARTS_PER_HOUR)); then
			echo "dpistack-watch: $id: restart limit ($RESTARTS_PER_HOUR per hour) used up" >&2
			stamps="${kept[*]}"
		else
			echo "dpistack-watch: restarting $id" >&2
			"$CTL" restart "$id" >/dev/null 2>&1 || echo "dpistack-watch: restarting $id failed" >&2
			kept+=("$now_s")
			stamps="${kept[*]}"
		fi
		state_write_value "$key" "$stamps"
	done
}

# prune_exceptions - the exceptions past their last day are removed.
# Suricata does not know about dates, so someone has to take them out.
# A failure is not a health problem of the stand: it is left for the next run.
prune_exceptions() {
	"$CTL" exceptions prune >/dev/null 2>&1 || true
}

main() {
	mkdir -p "$(path_state_dir)"
	exec 9>"$(path_state_dir)/.watch.lock"
	flock -n 9 || exit 0

	config_reset
	config_load_defaults
	[[ -r "$(path_conf)" ]] && config_load_kv_file "$(path_conf)"
	[[ -r "$(path_secrets)" ]] && config_load_kv_file "$(path_secrets)"
	IFS=',' read -ra CHANNELS <<<"${CONF[ALERT_CHANNELS]}"

	load_component_states
	check_status_read
	local id
	for id in suricata evebox ntopng redis panel victoriametrics prometheus node_exporter grafana; do
		# Backends are listed by `ctl status` only when selected.
		[[ -n "${COMP_STATE[$id]:-}" ]] || continue
		check_process "$id"
		[[ "$id" == "suricata" ]] || check_port "$id"
	done
	check_eve_fresh
	check_drop_rate
	check_disk_free
	check_redis_stream
	check_migrate_pending
	check_rules_age
	prune_exceptions

	write_health
	autorestart
	# Last: delivery can wait on a channel that does not answer, and the
	# health file above must not wait for it.
	detect_notify
}

main "$@"
